# Sentry error tracking (optional — silent fallback without DSN)
VITE_SENTRY_DSN=

# PostHog product analytics (optional — silent fallback without key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Mistral (server-only on Vercel / Vite middleware — NEVER VITE_ prefix)
# Set in Vercel Project → Settings → Environment Variables (Production + Preview)
# Local: .env.local (gitignored)
MISTRAL_API_KEY=

# Base44 optional (legacy auth/entities/share — AI no longer uses Base44 functions)
# VITE_BASE44_APP_ID=
# VITE_BASE44_API_KEY=
# VITE_BASE44_FUNCTIONS_VERSION=v1
# VITE_BASE44_APP_BASE_URL=https://app.base44.com
