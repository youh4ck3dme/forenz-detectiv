# Sentry error tracking (optional — silent fallback without DSN)
VITE_SENTRY_DSN=

# PostHog product analytics (optional — silent fallback without key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Base44 (prefer env / platform injection — do not commit secrets)
VITE_BASE44_APP_ID=
VITE_BASE44_API_KEY=
VITE_BASE44_FUNCTIONS_VERSION=v1
VITE_BASE44_APP_BASE_URL=https://app.base44.com

# Production URL (reference only — not read by app; Vite uses window.location.origin)
# https://forenz-detectiv.vercel.app

# Monetization hard-disabled for clean production testing (see src/lib/monetization.js).
# Stripe client removed — do not set VITE_STRIPE_* until RB-05 re-enable.

# Mistral (server-only: Base44 `base44 secret set MISTRAL_API_KEY` and Vercel env. NEVER VITE_ — that would leak into the browser bundle)
MISTRAL_API_KEY=
